# 基础镜像由运维提供：Debian + Go 1.27.1（已含 Go 工具链，无需再安装 Go）
FROM prereg.caixin.com/devops/debian-golang_1271:20260922

WORKDIR /app

# 1) 先拉取依赖（go.mod/go.sum 变更时才重新下载，利用镜像层缓存加速 rebuild）
COPY go.mod go.sum ./
RUN go mod download

# 2) 拷贝源码并编译静态二进制（-s -w 去调试符号，进一步瘦身）
COPY . .
RUN go build -ldflags="-s -w" -o /app/bin/nacos-sync-backend ./cmd/server

# 服务端口（与代码中监听端口一致）
EXPOSE 9696

ENTRYPOINT ["/app/bin/nacos-sync-backend"]
CMD ["-c", "configs/config-test.yaml"]
